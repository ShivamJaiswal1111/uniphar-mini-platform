@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var rootName = Model.Root()?.Name ?? "";
    var address = Model.Value<string>("address");
    var phone = Model.Value<string>("phoneNumber");
    var email = Model.Value<string>("emailAddress");
    var mapEmbed = Model.Value<string>("googleMapsEmbed");
    var officeImage = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("officeImage");
}
<!DOCTYPE html>
<html>
<head><title>@Model.Name</title></head>
<body style="font-family: sans-serif; margin: 0;">
    <nav style="background:#111; padding: 16px 32px; display:flex; gap: 24px;">
        <a href="/" style="color:white; text-decoration:none;">Home</a>
        @if (rootName == "Uniphar Group")
        {
            <a href="/about-us/" style="color:white; text-decoration:none;">About</a>
            <a href="/investors/" style="color:white; text-decoration:none;">Investors</a>
            <a href="/sustainability/" style="color:white; text-decoration:none;">Sustainability</a>
        }
        else if (rootName == "Uniphar Medtech")
        {
            <a href="/services/" style="color:white; text-decoration:none;">Services</a>
        }
        else if (rootName == "Uniphar Pharma")
        {
            <a href="/products/" style="color:white; text-decoration:none;">Products</a>
        }
        <a href="/contact/" style="color:white; text-decoration:none;">Contact</a>
    </nav>
    <header style="background:#1b264f; color:white; padding: 60px 32px;">
        <h1>Contact</h1>
    </header>
    <section style="padding: 40px 32px;">
        <p>@address</p>
        <p>Phone: @phone</p>
        <p>Email: @email</p>
        <h2 style="font-size: 22px; font-weight: 600; color: #1b264f; margin-top: 48px; margin-bottom: 16px;">Our Office</h2>
        <div style="display: flex; gap: 24px; flex-wrap: wrap;">
            @if (officeImage != null)
            {
                <div style="flex: 1; min-width: 300px;">
                    <img src="@officeImage.Url()" alt="Office" style="width: 100%; height: 320px; object-fit: cover; border-radius: 8px; display: block;" />
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(mapEmbed))
            {
                <div style="flex: 1; min-width: 300px; height: 320px; border-radius: 8px; overflow: hidden;">
                    @Html.Raw(mapEmbed)
                </div>
            }
        </div>
    </section>
</body>
</html>