@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var rootName = Model.Root()?.Name ?? "";
    var introduction = Model.Value<Umbraco.Cms.Core.Strings.IHtmlEncodedString>("introduction");
    var keyStats = Model.Value<Umbraco.Cms.Core.Models.Blocks.BlockListModel>("keyStats");
    var tickerEmbed = Model.Value<string>("stockTickerEmbed");
    var year = Model.Value<int>("year");
    var annualReport = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("annualReportPdf");
    var presentation = Model.Value<Umbraco.Cms.Core.Models.PublishedContent.IPublishedContent>("resultsPresentationPdf");
}
<!DOCTYPE html>
<html>
<head><title>@Model.Name</title></head>
<body style="font-family: sans-serif; margin: 0;">
    <nav style="background:#111; padding: 16px 32px; display:flex; gap: 24px;">
        <a href="/" style="color:white; text-decoration:none;">Home</a>
        @if (rootName == "Uniphar Group")
        {
            <a href="/about-us/" style="color:white; text-decoration:none;">About</a>
            <a href="/investors/" style="color:white; text-decoration:none;">Investors</a>
            <a href="/sustainability/" style="color:white; text-decoration:none;">Sustainability</a>
        }
        else if (rootName == "Uniphar Medtech")
        {
            <a href="/services/" style="color:white; text-decoration:none;">Services</a>
        }
        else if (rootName == "Uniphar Pharma")
        {
            <a href="/products/" style="color:white; text-decoration:none;">Products</a>
        }
        <a href="/contact/" style="color:white; text-decoration:none;">Contact</a>
    </nav>
    <header style="background:#1b264f; color:white; padding: 60px 32px;">
        <h1>@Model.Name</h1>
    </header>
    <section style="padding: 40px 32px;">
        <div>@Html.Raw(introduction)</div>
    </section>
    @if (keyStats != null && keyStats.Any())
    {
        <section style="padding: 0 32px 40px; display: flex; gap: 24px; flex-wrap: wrap;">
            @foreach (var block in keyStats)
            {
                <div style="text-align:center; padding: 24px; background:#f5f5f5; border-radius: 8px; min-width: 150px;">
                    <div style="font-size: 32px; font-weight: bold;">@block.Content.Value("statValue")</div>
                    <div>@block.Content.Value("statLabel")</div>
                </div>
            }
        </section>
    }
    @if (!string.IsNullOrWhiteSpace(tickerEmbed))
    {
        <h2 style="font-size: 22px; font-weight: 600; color: #1b264f; padding: 0 32px; margin-bottom: 16px;">Share Price</h2>
        <section style="padding: 0 32px 40px;">
            <div style="max-width: 600px; height: 320px; border-radius: 8px; overflow: hidden;">
                @Html.Raw(tickerEmbed)
            </div>
        </section>
    }
    <section style="padding: 0 32px 40px;">
        <p>FY @year</p>
        @if (annualReport != null)
        {
            <a href="@annualReport.Url()" target="_blank" style="display:inline-block; margin-right:16px; padding:10px 20px; background:#1b264f; color:white; border-radius:4px; text-decoration:none;">Download Annual Report</a>
        }
        @if (presentation != null)
        {
            <a href="@presentation.Url()" target="_blank" style="display:inline-block; padding:10px 20px; background:#0066cc; color:white; border-radius:4px; text-decoration:none;">Download Presentation</a>
        }
    </section>
</body>
</html>