{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "OpenIddict": {
    "Server": {
      "DisableTransportSecurityRequirement": true
    }
  },
  
  "Umbraco": {
    "CMS": {
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto"
      },
      "Global": {
        "Id": "00000000-0000-0000-0000-000000000000",
        "SanitizeTinyMce": true,
        "SqlWriteLockTimeOut": "00:01:00"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "RichTextOutputAsJson": false,
        "DisallowedContentTypeAliases": []
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=YOUR_SQL_SERVER;Database=UniPharGroup;Integrated Security=true;TrustServerCertificate=true;Connect Timeout=300;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  }
}