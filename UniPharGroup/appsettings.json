{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    }
  },
  "OpenIddict": {
    "Server": {
      "DisableTransportSecurityRequirement": true
    }
  },
  "Umbraco": {
    "CMS": {
      "ModelsBuilder": {
        "ModelsMode": "InMemoryAuto"
      },
      "Global": {
        "Id": "803ef4ad-839b-4f13-acd5-f85c7cbd5e17",
        "SanitizeTinyMce": true,
        "SqlWriteLockTimeOut": "00:01:00"
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "UpgradeUnattended": true
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true,
        "RichTextOutputAsJson": false,
        "DisallowedContentTypeAliases": []
      },
      "ManagementApi": {
        "ApiKey": "uniphar-mgmt-key-2026"
      }
    }
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=Shivam_DreamIT\\SQLEXPRESS;Database=UniPharGroup;Integrated Security=true;TrustServerCertificate=true;Connect Timeout=300;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  }
}